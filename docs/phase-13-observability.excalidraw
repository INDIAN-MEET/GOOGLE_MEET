: false, "text": "Prometheus has no user JWT\nBearer METRICS_TOKEN = its key\nCompared with timingSafeEqual\n(no timing attack)\nMounted BEFORE auth + rate limiter\n(scrapes never get 429)", "fontSize": 17, "fontFamily": 6, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Prometheus has no user JWT\nBearer METRICS_TOKEN = its key\nCompared with timingSafeEqual\n(no timing attack)\nMounted BEFORE auth + rate limiter\n(scrapes never get 429)", "lineHeight": 1.3, "autoResize": true, "baseline": 15}, {"id": "e0432", "type": "rectangle", "x": 64, "y": 5335, "width": 740, "height": 280, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e9e5de", "fillStyle": "solid", "strokeWidth": 0, "strokeStyle": "solid", "roughness": 0, "opacity": 60, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1198308235, "version": 1, "versionNonce": 93188264, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e0433", "type": "rectangle", "x": 60, "y": 5330, "width": 740, "height": 280, "angle": 0, "strokeColor": "#d8d3ca", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1192222410, "version": 1, "versionNonce": 1552021641, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e0434", "type": "text", "x": 311.5, "y": 5344, "width": 237.00000000000003, "height": 27.3, "angle": 0, "strokeColor": "#2b2d42", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 404639977, "version": 1, "versionNonce": 57732788, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "LOCALHOST-ONLY tools", "fontSize": 21, "fontFamily": 6, "text