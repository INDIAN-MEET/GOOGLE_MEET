6119904, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e0438", "type": "text", "x": 1179.95, "y": 5344, "width": 260.1, "height": 27.3, "angle": 0, "strokeColor": "#2b2d42", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1931188132, "version": 1, "versionNonce": 911793941, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "TRACING = FIRST IMPORT", "fontSize": 21, "fontFamily": 6, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "TRACING = FIRST IMPORT", "lineHeight": 1.3, "autoResize": true, "baseline": 18}, {"id": "e0439", "type": "text", "x": 1148.05, "y": 5381.3, "width": 323.90000000000003, "height": 132.6, "angle": 0, "strokeColor": "#2b2d42", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 91531948, "version": 1, "versionNonce": 1663866199, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "OTel must patch http, express, pg,\nioredis, mongodb BEFORE they load\nESM runs imports in order:\nfirst line = first to run\nIgnore /metrics /health /ready\n(no Jaeger flood)", "fontSize": 17, "fontFamily": 6, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "OTel must patch http, express, pg,\nioredis, mongodb BEFORE they load\nESM runs imports in order:\nfirst line = first to run\nIgnore /metrics /health /ready\n(no Jaeger flood)", "lineHeight": 1.3, "autoResize": true, "baseline": 15}, {"id": "e0440", "type": "rectangle", "x": 1824, "y": 5335, "width": 740, "height": 280, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e9e5de", "fillStyle": "solid", "strokeWidth"