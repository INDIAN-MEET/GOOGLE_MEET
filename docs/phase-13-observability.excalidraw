n? try/catch,\n/metrics still works\nGauges read only at scrape time\nres.on('close') keeps in-flight honest", "fontSize": 17, "fontFamily": 6, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "OTel fails to start? Log it, keep running\nOTEL_ENABLED=false = zero cost\nBroken SFU stats fn? try/catch,\n/metrics still works\nGauges read only at scrape time\nres.on('close') keeps in-flight honest", "lineHeight": 1.3, "autoResize": true, "baseline": 15}, {"id": "e0444", "type": "rectangle", "x": 44, "y": 5695, "width": 2520, "height": 60, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#e9e5de", "fillStyle": "solid", "strokeWidth": 0, "strokeStyle": "solid", "roughness": 0, "opacity": 60, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 343239785, "version": 1, "versionNonce": 944476403, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e0445", "type": "rectangle", "x": 40, "y": 5690, "width": 2520, "height": 60, "angle": 0, "strokeColor": "#3d405b", "backgroundColor": "#3d405b", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1655903458, "version": 1, "versionNonce": 442447608, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e0446", "type": "text", "x": 1012.0999999999999, "y": 5701.8, "width": 575.8000000000001, "height": 36.4, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 926094741, "version": 1, "versionNonce": 1619337284, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "8.  BUILD ORDER (Steps 13.1 -> 13.15)", "fontSize": 28, "fontFamily": 6, "textAlign": "center",